{
    // The Raspberry Pi Pico extension's buttons (Compile / Run) start the
    // tasks named "Compile Project" and "Run Project".
    //
    // They call this project's own scripts, so the buttons and the command
    // line do exactly the same thing, with the tool versions pinned in
    // scripts/env.ps1.
    //
    // "Run Project" flashes over USB with picotool and needs no J-Link and
    // no BOOTSEL button (the USB firmware has the reset interface). The
    // J-Link tasks are for debugging, and for firmware without USB
    // (mlx_thermal_udp), which USB flashing cannot restart by itself.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/build.ps1"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/flash_usb.ps1"
            ],
            "dependsOn": "Compile Project",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Flash over USB (choose firmware)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/flash_usb.ps1",
                "-Firmware", "${input:firmware}"
            ],
            "dependsOn": "Compile Project",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Flash with J-Link (choose firmware)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/flash.ps1",
                "-Elf", "${workspaceFolder}/build/firmware/${input:firmware}.elf"
            ],
            "dependsOn": "Compile Project",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "RTT log",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/rtt.ps1",
                "-Elf", "${workspaceFolder}/build/firmware/${input:firmware}.elf"
            ],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ],
    "inputs": [
        {
            "id": "firmware",
            "type": "pickString",
            "description": "Which firmware image?",
            "default": "mlx_thermal",
            "options": [
                "mlx_thermal",
                "mlx_thermal_udp",
                "mlx_thermal_16hz",
                "mlx_thermal_64hz",
                "net_test",
                "pin_test",
                "rise_test",
                "eeprom_test_400k",
                "eeprom_test_1000k",
                "eeprom_soak_1000k"
            ]
        }
    ]
}
