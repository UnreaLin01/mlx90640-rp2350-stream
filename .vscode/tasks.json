{
    // The Raspberry Pi Pico extension's buttons (Compile / Run) start the
    // tasks named "Compile Project" and "Run Project".
    //
    // They call this project's own scripts, so the buttons and the command
    // line do exactly the same thing, with the tool versions pinned in
    // scripts/env.ps1.
    //
    // "Run Project" flashes over USB with picotool, without a J-Link. When
    // that cannot work because the board has to be put into BOOTSEL first,
    // flash_usb.ps1 says so and says what to do, so the menu does not have
    // to explain it here.
    //
    // The J-Link tasks work whatever is on the board, and they are the way
    // to recover one that USB can no longer reach.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/build.ps1"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/flash_usb.ps1"
            ],
            "dependsOn": "Compile Project",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Flash over USB (choose firmware)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/flash_usb.ps1",
                "-Firmware", "${input:firmware}"
            ],
            "dependsOn": "Compile Project",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Flash with J-Link (choose firmware)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/flash.ps1",
                "-Elf", "${workspaceFolder}/build/images/${input:firmware}.elf"
            ],
            "dependsOn": "Compile Project",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        }
    ],
    // Only the two firmwares that stream thermal images are offered. The
    // test images are development tools: putting them in a menu everyone
    // sees is noise, so they are flashed from the command line instead
    // (docs/debugging.md has the commands).
    "inputs": [
        {
            "id": "firmware",
            "type": "pickString",
            "description": "Which firmware image?",
            "default": "mlx_thermal",
            "options": [
                // VS Code shows each option as "label: value", so the label
                // holds only the explanation, never the name again.
                { "value": "mlx_thermal", "label": "stream over USB" },
                { "value": "mlx_thermal_udp", "label": "stream over Ethernet" }
            ]
        }
    ]
}
